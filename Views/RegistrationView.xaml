<UserControl x:Class="MisWpf.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel>
                <TextBlock Text="Оформление поступления" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <TextBlock Text="Найдите пациента в базе или зарегистрируйте нового, заполните данные поступления и сразу отправьте анализы и направления." Style="{StaticResource Hint}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- ===== Поиск пациента ===== -->
            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Поиск пациента" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBox Style="{StaticResource Input}" Margin="0,8,0,4" Height="34"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ФИО, телефон, паспорт или дата рождения" />
                        <TextBlock Text="{Binding SearchInfo}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Content="+ Новый пациент" Command="{Binding NewPatientCommand}" Margin="0,10,0,0" />
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPatient}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock Text="{Binding Fio}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Info}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Форма ===== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding PatientCaption}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Выберите пациента слева или нажмите «Новый пациент»." Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Visibility="{Binding HasPatient, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />

                            <StackPanel Visibility="{Binding IsNewPatient, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
                                <CheckBox Content="Неизвестный пациент (без документов, без сознания)" IsChecked="{Binding IsUnknown}" FontSize="13" />

                                <Grid Visibility="{Binding IsUnknown, Converter={StaticResource VisibleIf}}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Примерный возраст" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding ApproxAge, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Пол" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource ListCombo}" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Visibility="{Binding IsUnknown, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.ColumnSpan="3">
                                        <TextBlock Text="ФИО *" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="Дата рождения *" Style="{StaticResource FieldLabel}" />
                                        <DatePicker SelectedDate="{Binding BirthDate}" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Пол *" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource ListCombo}" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Паспорт" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Passport, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                                        <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="Социальный статус" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Style="{StaticResource ListCombo}" ItemsSource="{Binding PatientStatuses}" SelectedItem="{Binding PatientStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="Место работы / учёбы" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding WorkPlace, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Контактное лицо" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Телефон контактного лица" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Поступление" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Как поступил" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Button Style="{StaticResource SelectChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Кем доставлен / направлен" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding DeliveredBy, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="№ сопроводительного листа" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding SheetNumber, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Обстоятельства (что случилось, откуда доставлен)" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding SourceDetails, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Жалобы" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputMulti}" Text="{Binding Complaint, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Диагноз направившего / СМП" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding SmpDiagnosis, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Оказанная помощь на догоспитальном этапе" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding ProvidedCare, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Назначения при поступлении" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="Лаборатория" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding LabProfiles}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Button Style="{StaticResource SelectChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Инструментальные" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding InstrumentalChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Button Style="{StaticResource SelectChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Анализы уйдут лаборанту, направления на ЭКГ и рентген появятся у врача в списке исследований." Style="{StaticResource Hint}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                        <Button Style="{StaticResource Btn}" Content="Очистить" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource BtnPrimary}" Content="Оформить поступление" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Поступили за смену ===== -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Поступили за смену" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ShiftAdmissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding Fio}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
