<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:exam="clr-namespace:MisWpf.Exam">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Один критерий: подпись слева, варианты справа, уточнения под ними ===== -->
    <DataTemplate DataType="{x:Type exam:CriterionVm}">
        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource Ink2}" Margin="0,5,10,0" TextWrapping="Wrap" />

                <StackPanel Grid.Column="1">
                    <!-- Числовое поле -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumber, Converter={StaticResource VisibleIf}}">
                        <TextBox Width="90" Style="{StaticResource Input}"
                                 Text="{Binding NumberValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding NumberHint}" />
                        <TextBlock Text="{Binding Unit}" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Foreground="{StaticResource Warn}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding NumberOutOfRange, Converter={StaticResource VisibleIf}}">
                            <Run Text="вне нормы (" /><Run Text="{Binding NormText, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Варианты -->
                    <StackPanel Visibility="{Binding IsOptions, Converter={StaticResource VisibleIf}}">
                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OptionChip}" Content="{Binding Text}" Command="{Binding PickCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Уточнения: только при выборе отклонения -->
                        <Border BorderBrush="{StaticResource WarnLine}" BorderThickness="2,0,0,0" Padding="10,4,0,0" Margin="0,2,0,0"
                                Visibility="{Binding HasDetails, Converter={StaticResource VisibleIf}}">
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Sides}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToggleChip}" Content="{Binding Text}" Command="{Binding PickCommand}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ToggleChip}" Content="{Binding Text}" Command="{Binding PickCommand}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox MinWidth="220" Margin="0,0,0,5" Style="{StaticResource Input}" FontSize="12.5"
                                         Text="{Binding DetailText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DetailHint}"
                                         Visibility="{Binding HasDetailText, Converter={StaticResource VisibleIf}}" />
                                <TextBlock Text="{Binding DetailHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,5"
                                           Visibility="{Binding HasDetailText, Converter={StaticResource VisibleIf}}" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===== Раздел осмотра (сворачиваемый) ===== -->
    <DataTemplate DataType="{x:Type exam:SectionVm}">
        <Border x:Name="box" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="10,8" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Command="{Binding ToggleCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Visibility="{Binding Collapsible, Converter={StaticResource VisibleIf}}" ToolTip="Свернуть / развернуть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="chev" Text="▸" FontSize="15" Foreground="{StaticResource Muted}" Width="18" Margin="0,0,4,0" />
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter TargetName="chev" Property="Text" Value="▾" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button DockPanel.Dock="Left" Command="{Binding ToggleCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border x:Name="badge" DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{StaticResource Chip}">
                        <TextBlock x:Name="badgeText" Text="{Binding Badge}" FontSize="11.5" Foreground="{StaticResource Ink2}" />
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Очистить" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Норма" Command="{Binding NormCommand}"
                            ToolTip="Отметить норму во всех незаполненных строках раздела" />
                </DockPanel>

                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Ink2}" Margin="34,0,14,10"
                           Visibility="{Binding ShowSummary, Converter={StaticResource VisibleIf}}" />

                <ItemsControl ItemsSource="{Binding Criteria}" Focusable="False"
                              Visibility="{Binding IsOpen, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding BadgeKind}" Value="ok">
                <Setter TargetName="badge" Property="Background" Value="{StaticResource OkBg}" />
                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Ok}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="warn">
                <Setter TargetName="badge" Property="Background" Value="{StaticResource WarnBg}" />
                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Warn}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource WarnLine}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentLine}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
