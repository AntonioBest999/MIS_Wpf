<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MisWpf.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Цвет плашки по виду: ok / wait / flag / ordered / accent / neutral.
         Ожидается DataContext со свойством Kind (TagVm) или StatusKind (строки заказов). -->
    <Style x:Key="KindBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="ok"><Setter Property="BorderBrush" Value="{StaticResource OkLine}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="wait"><Setter Property="BorderBrush" Value="{StaticResource WarnLine}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="flag"><Setter Property="BorderBrush" Value="{StaticResource DangerLine}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KindText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="wait"><Setter Property="Foreground" Value="{StaticResource Warn}" /></DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="flag"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type vm:TagVm}">
        <Border Style="{StaticResource KindBadge}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource KindText}" />
        </Border>
    </DataTemplate>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{StaticResource Chip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Background" Value="{StaticResource OkBg}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="wait"><Setter Property="Background" Value="{StaticResource WarnBg}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="flag"><Setter Property="Background" Value="{StaticResource DangerBg}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="accent"><Setter Property="Background" Value="{StaticResource AccentBg}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="ok"><Setter Property="Foreground" Value="{StaticResource Ok}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="wait"><Setter Property="Foreground" Value="{StaticResource Warn}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="flag"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="accent"><Setter Property="Foreground" Value="{StaticResource AccentDark}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Таймер: Kind = normal / warn / danger (свойство TimerKind у DataContext) -->
    <Style x:Key="TimerBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Background" Value="{StaticResource Chip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TimerKind}" Value="warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /></DataTrigger>
            <DataTrigger Binding="{Binding TimerKind}" Value="danger"><Setter Property="Background" Value="{StaticResource DangerBg}" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TimerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TimerKind}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Warn}" /></DataTrigger>
            <DataTrigger Binding="{Binding TimerKind}" Value="danger"><Setter Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Карточка пациента в очереди приёмного ===== -->
    <DataTemplate DataType="{x:Type vm:QueueCardVm}">
        <Button Style="{StaticResource CardButton}" Command="{Binding SelectCommand}">
            <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="stripe" CornerRadius="9,0,0,9" Background="{StaticResource Neutral}" />
                    <StackPanel Grid.Column="1" Margin="10,9,11,9">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource TimerBadge}">
                                <TextBlock Text="{Binding Timer}" Style="{StaticResource TimerText}" />
                            </Border>
                            <TextBlock Text="{Binding Fio}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <Border x:Name="src" DockPanel.Dock="Right" CornerRadius="5" Padding="7,2" Background="{StaticResource Chip}">
                                <TextBlock x:Name="srcText" Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" />
                            </Border>
                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border Background="{StaticResource DangerBg}" CornerRadius="6" Padding="8,5" Margin="0,7,0,0"
                                Visibility="{Binding IsReturned, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding ReturnText}" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                        </Border>
                        <Border BorderBrush="#E6EAEE" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource OkBg}" CornerRadius="5" Padding="8,2" VerticalAlignment="Top"
                                        Visibility="{Binding IsReady, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="Готов к решению" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Ok}" />
                                </Border>
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="Исследования не назначены" FontSize="12" Foreground="{StaticResource Muted}"
                                               Visibility="{Binding NoTags, Converter={StaticResource VisibleIf}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding StripeKind}" Value="warn"><Setter TargetName="stripe" Property="Background" Value="{StaticResource WarnLine}" /></DataTrigger>
            <DataTrigger Binding="{Binding StripeKind}" Value="danger"><Setter TargetName="stripe" Property="Background" Value="{StaticResource DangerSolid}" /></DataTrigger>
            <DataTrigger Binding="{Binding StripeKind}" Value="ok"><Setter TargetName="stripe" Property="Background" Value="{StaticResource OkSolid}" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSmp}" Value="True">
                <Setter TargetName="src" Property="Background" Value="{StaticResource AccentBg}" />
                <Setter TargetName="srcText" Property="Foreground" Value="{StaticResource AccentDark}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsReturned}" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource DangerLine}" /></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="card" Property="Background" Value="#EEF7FA" />
                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="card" Property="BorderThickness" Value="1.5" />
            </DataTrigger>
            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="#8FA3B3" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Карточка заказа у лаборанта ===== -->
    <DataTemplate DataType="{x:Type vm:LabCardVm}">
        <Button Style="{StaticResource CardButton}" Command="{Binding SelectCommand}">
            <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="13,9,11,9">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource TimerBadge}">
                            <TextBlock Text="{Binding Timer}" Style="{StaticResource TimerText}" />
                        </Border>
                        <TextBlock Text="{Binding Fio}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" FontSize="11.5" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="card" Property="Background" Value="#EEF7F2" />
                <Setter TargetName="card" Property="BorderBrush" Value="#1E7A46" />
                <Setter TargetName="card" Property="BorderThickness" Value="1.5" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
