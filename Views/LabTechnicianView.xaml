<UserControl x:Class="MisWpf.Views.LabTechnicianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource Btn}" Content="Обновить" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Лабораторные заказы" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,20,0" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Run Text="Новых " /><Run Text="{Binding NewCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center">
                        <Run Text="В работе " /><Run Text="{Binding InWorkCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Очередь заказов ===== -->
            <DockPanel Margin="0,0,14,0">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Filters}" Margin="0,0,0,6" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><Button Style="{StaticResource SelectChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Hint}" Margin="4,10,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" />
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Ввод результатов ===== -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <Grid>
                    <TextBlock Text="Выберите заказ слева" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoSelection, Converter={StaticResource VisibleIf}}" />
                    <Grid Visibility="{Binding HasSelected, Converter={StaticResource VisibleIf}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="18,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="9,3" Background="{StaticResource Chip}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedFio}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding SelectedSub}" FontSize="13" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,10,18,10">
                            <StackPanel>
                                <TextBlock Text="Заказ выполнен. Результаты отправлены врачу и больше не редактируются." Foreground="{StaticResource Ok}" FontSize="13" Margin="0,0,0,8"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource VisibleIf}}" />
                                <!-- Заголовок таблицы -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Показатель" Style="{StaticResource GroupTitle}" />
                                    <TextBlock Grid.Column="1" Text="Результат" Style="{StaticResource GroupTitle}" />
                                    <TextBlock Grid.Column="3" Text="Ед." Style="{StaticResource GroupTitle}" />
                                    <TextBlock Grid.Column="4" Text="Норма" Style="{StaticResource GroupTitle}" />
                                    <TextBlock Grid.Column="5" Text="Комментарий" Style="{StaticResource GroupTitle}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3*" />
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="110" />
                                                                        <ColumnDefinition Width="2*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                    <TextBox x:Name="res" Grid.Column="1" Style="{StaticResource Input}" Margin="0,0,6,0"
                                                                             Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" />
                                                                    <TextBlock x:Name="flag" Grid.Column="2" Text="{Binding Flag}" FontSize="15" FontWeight="Bold"
                                                                               Foreground="{StaticResource Danger}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Units}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="4" Text="{Binding RefText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="5" Style="{StaticResource Input}" FontSize="12"
                                                                             Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" IsTabStop="False" />
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                                    <Setter TargetName="res" Property="BorderBrush" Value="{StaticResource DangerLine}" />
                                                                    <Setter TargetName="res" Property="Background" Value="#FFF8F7" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="18,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" Content="Взять в работу" Command="{Binding TakeCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Btn}" Content="Сохранить черновик" Command="{Binding SaveDraftCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource BtnPrimary}" Content="Завершить и отправить врачу" Command="{Binding CompleteCommand}" />
                                </StackPanel>
                                <TextBlock Text="Enter — следующий показатель. ↑ / ↓ — выход за пределы нормы."
                                           Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
