<Window x:Class="MisWpf.Views.ProtocolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Протокол первичного осмотра" Width="760" Height="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource Panel}" Margin="16" Padding="24,20">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Копировать текст" Click="Copy_Click" />
                <TextBlock Text="Протокол первичного осмотра" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            </DockPanel>
            <TextBlock x:Name="Subtitle" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,14" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" FontSize="13.5" Margin="0,0,0,10" Foreground="{StaticResource Ink}" LineHeight="21">
                                <Run Text="{Binding Item1, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". " /><Run Text="{Binding Item2, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
