<UserControl x:Class="MisWpf.Views.ReceptionDoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- Строка исследования в центре -->
        <DataTemplate x:Key="OrderRowWide">
            <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Margin="0">
                <Border x:Name="row" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="14,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" MinWidth="110">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource BgSoft}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Компактная строка исследования справа -->
        <DataTemplate x:Key="OrderRowCompact">
            <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Margin="0,0,0,5">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="9,7">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                    </DockPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Верхняя полоса ================= -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource Btn}" Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource BtnPrimary}" Content="+ Новое поступление" Command="{Binding NewAdmissionCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,18,0">
                        <Run Text="Поступило " /><Run Text="{Binding ShiftTotal, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,18,0">
                        <Run Text="Госпитализировано " /><Run Text="{Binding ShiftHosp, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,18,0">
                        <Run Text="Отказ " /><Run Text="{Binding ShiftRefused, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}">
                        <Run Text="В работе " /><Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- ================= Очередь ================= -->
            <DockPanel Margin="0,0,14,0">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ThresholdsText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock Text="Очередь" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource VisibleIf}}">
                                        <DockPanel Margin="2,10,2,5">
                                            <TextBlock x:Name="cnt" DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource GroupTitle}" />
                                            <TextBlock x:Name="title" Text="{Binding Title}" Style="{StaticResource GroupTitle}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="accent"><Setter TargetName="title" Property="Foreground" Value="{StaticResource AccentDark}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter TargetName="title" Property="Foreground" Value="{StaticResource Warn}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="ok"><Setter TargetName="title" Property="Foreground" Value="{StaticResource Ok}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter TargetName="title" Property="Foreground" Value="{StaticResource Danger}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Очередь пуста. Новые поступления появятся здесь автоматически." Style="{StaticResource Hint}" Margin="4,16,4,0"
                                   Visibility="{Binding ActiveCount, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ================= Работа с пациентом ================= -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,14,0">
                <Grid>
                    <TextBlock Text="Выберите пациента в очереди слева" Style="{StaticResource Hint}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoSelection, Converter={StaticResource VisibleIf}}" />

                    <Grid Visibility="{Binding HasSelected, Converter={StaticResource VisibleIf}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Шапка пациента -->
                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="18,12">
                            <WrapPanel>
                                <TextBlock Text="{Binding PatientFio}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding PatientMeta}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Chip}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeaderTimerKind}" Value="warn"><Setter Property="Background" Value="{StaticResource WarnBg}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HeaderTimerKind}" Value="danger"><Setter Property="Background" Value="{StaticResource DangerBg}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding HeaderTimer}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Ink2}" />
                                </Border>
                                <Border CornerRadius="6" Padding="9,3" Background="{StaticResource DangerBg}" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Visibility="{Binding Allergy, Converter={StaticResource VisibleIf}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Danger}">
                                        <Run Text="Аллергия: " /><Run Text="{Binding Allergy, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border CornerRadius="6" Padding="9,3" Background="{StaticResource Chip}" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Visibility="{Binding NoAllergyInfo, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="Аллергоанамнез не собран" FontSize="12" Foreground="{StaticResource Ink2}" />
                                </Border>
                                <Border CornerRadius="6" Padding="9,3" Background="{StaticResource Chip}" VerticalAlignment="Center"
                                        Visibility="{Binding PriorStay, Converter={StaticResource VisibleIf}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Ink2}">
                                        <Run Text="Был: " /><Run Text="{Binding PriorStay, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </Border>

                        <!-- Возврат от заведующего -->
                        <Border Grid.Row="1" Margin="18,12,18,0" Padding="12,10" CornerRadius="8" Background="{StaticResource DangerBg}"
                                BorderBrush="{StaticResource DangerLine}" BorderThickness="1"
                                Visibility="{Binding IsReturned, Converter={StaticResource VisibleIf}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="К решению" Command="{Binding GoToDecisionCommand}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ReturnTitle}" FontWeight="SemiBold" Foreground="#8F1D14" />
                                    <TextBlock Text="{Binding ReturnHint}" FontSize="12.5" Foreground="#8F1D14" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Шаги -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Steps}" Margin="18,12,18,10" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding GoCommand}" Cursor="Hand" Margin="0,0,6,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Surface}" Padding="10,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="num" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Chip}">
                                                            <TextBlock x:Name="mark" Text="{Binding Mark}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock x:Name="label" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink2}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter TargetName="num" Property="Background" Value="{StaticResource OkBg}" />
                                                        <Setter TargetName="mark" Property="Foreground" Value="{StaticResource Ok}" />
                                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBg}" />
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="num" Property="Background" Value="{StaticResource Accent}" />
                                                        <Setter TargetName="mark" Property="Foreground" Value="White" />
                                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource AccentDark}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Содержимое шага -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="18,0,18,12">
                            <StackPanel>

                                <!-- ===== Шаг 1. Поступление ===== -->
                                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource VisibleIf}}">
                                    <Border Background="{StaticResource BgSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,4"
                                            Visibility="{Binding HasArrivalInfo, Converter={StaticResource VisibleIf}}">
                                        <StackPanel>
                                            <TextBlock Text="ДАННЫЕ ПРИ ПОСТУПЛЕНИИ" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Кем доставлен" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2" />
                                                <TextBlock Grid.Column="1" Text="{Binding ArrivalDeliveredBy}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                                <TextBlock Grid.Row="1" Text="Обстоятельства" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArrivalDetails}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                                <TextBlock Grid.Row="2" Text="Диагноз направившего" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArrivalDiagnosis}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                                <TextBlock Grid.Row="3" Text="Оказанная помощь" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ArrivalCare}" FontSize="13" TextWrapping="Wrap" Margin="0,2" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Жалобы" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputMulti}" Text="{Binding Exam.Complaint, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Анамнез заболевания" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputMulti}" MinHeight="72" Text="{Binding Exam.AnamnesisMorbi, UpdateSourceTrigger=PropertyChanged}" />
                                    <ContentControl Content="{Binding AnamnesisSection}" Margin="0,14,0,0" Focusable="False" />
                                </StackPanel>

                                <!-- ===== Шаг 2. Объективно ===== -->
                                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource VisibleIf}}">
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Всё в норме" Command="{Binding AllNormCommand}"
                                                ToolTip="Отметить норму во всех незаполненных строках всех разделов" />
                                        <TextBlock Text="Нажмите «Норма» в разделе или «Всё в норме», затем отметьте только отклонения. Отклонения подсвечиваются жёлтым."
                                                   Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding ObjectiveSections}" Focusable="False" />
                                </StackPanel>

                                <!-- ===== Шаг 3. Исследования ===== -->
                                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource VisibleIf}}">
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                        <StackPanel>
                                            <TextBlock Text="Назначенные исследования" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="14,10" />
                                            <ItemsControl ItemsSource="{Binding Orders}" ItemTemplate="{StaticResource OrderRowWide}" Focusable="False" />
                                            <TextBlock Text="Пока ничего не назначено." Style="{StaticResource Hint}" Margin="14,0,14,12"
                                                       Visibility="{Binding NoOrders, Converter={StaticResource VisibleIf}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Результат выбранного исследования -->
                                    <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10" Background="#F5FAFC" BorderBrush="#A9D2E0" BorderThickness="1"
                                            Visibility="{Binding ShowResult, Converter={StaticResource VisibleIf}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Закрыть" Command="{Binding CloseResultCommand}" />
                                                <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="Результат ещё не готов: лаборатория работает над заказом." Foreground="{StaticResource Warn}" FontSize="13" Margin="0,0,0,6"
                                                       Visibility="{Binding ResultWaiting, Converter={StaticResource VisibleIf}}" />
                                            <ItemsControl ItemsSource="{Binding ResultRows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E1ECF1" BorderThickness="0,1,0,0" Padding="0,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3*" />
                                                                    <ColumnDefinition Width="2*" />
                                                                    <ColumnDefinition Width="2*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" />
                                                                <TextBlock x:Name="val" Grid.Column="1" FontSize="13" FontWeight="SemiBold">
                                                                    <Run Text="{Binding Value, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Flag, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Text="{Binding Ref}" FontSize="12" Foreground="{StaticResource Muted}" />
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                                <Setter TargetName="val" Property="Foreground" Value="{StaticResource Danger}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding ResultText}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                                       Visibility="{Binding ResultText, Converter={StaticResource VisibleIf}}" />
                                            <StackPanel Visibility="{Binding ResultNeedsConclusion, Converter={StaticResource VisibleIf}}" Margin="0,8,0,0">
                                                <TextBlock Text="Заключение" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputMulti}" Text="{Binding InstrumentalConclusion, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Style="{StaticResource Btn}" Content="Отметить выполненным" Command="{Binding MarkInstrumentalDoneCommand}"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Назначить анализы" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                    <ItemsControl ItemsSource="{Binding LabProfiles}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><Button Style="{StaticResource SelectChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource BtnPrimary}" Content="Отправить в лабораторию" Command="{Binding SendLabCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                                    <TextBlock Text="Направить на исследование" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                                    <ItemsControl ItemsSource="{Binding InstrumentalButtons}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Btn}" Command="{Binding PickCommand}" Margin="0,0,6,6">
                                                    <TextBlock><Run Text="+ " /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ===== Шаг 4. Решение ===== -->
                                <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource VisibleIf}}">
                                    <ItemsControl ItemsSource="{Binding DecisionOptions}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding PickCommand}" Cursor="Hand" Margin="0,0,8,8">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Surface}" Padding="12,12">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8FA3B3" /></Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBg}" />
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                    <Setter TargetName="b" Property="BorderThickness" Value="1.5" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Госпитализация -->
                                    <StackPanel Visibility="{Binding IsHospDecision, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Отделение" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding Departments}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding PickCommand}" Cursor="Hand" Margin="0,0,6,6">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Surface}" Padding="10,8">
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PatientsText}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                        <TextBlock x:Name="n" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8FA3B3" /></Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBg}" />
                                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                        <Setter TargetName="n" Property="Foreground" Value="{StaticResource AccentDark}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource BgSoft}" />
                                                                        <Setter TargetName="n" Property="Foreground" Value="{StaticResource Muted}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Отказ -->
                                    <StackPanel Visibility="{Binding IsRefuseDecision, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Причина" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding Reasons}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><Button Style="{StaticResource ToggleChip}" Content="{Binding Text}" Command="{Binding PickCommand}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Рекомендации пациенту" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource InputMulti}" Text="{Binding Exam.Recommendations, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Перевод -->
                                    <StackPanel Visibility="{Binding IsTransferDecision, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Куда переводится (учреждение)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Exam.TransferTo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBlock Text="Пациент остаётся в очереди приёмного отделения, данные осмотра сохраняются до решения."
                                               Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Visibility="{Binding IsObserveDecision, Converter={StaticResource VisibleIf}}" />

                                    <StackPanel Visibility="{Binding HasDecision, Converter={StaticResource VisibleIf}}">
                                        <TextBlock Text="Диагноз (МКБ-10)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Exam.Diagnosis, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Помощь, оказанная в приёмном отделении" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource InputMulti}" Text="{Binding Exam.CareInReception, UpdateSourceTrigger=PropertyChanged}" />

                                        <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource WarnBg}" BorderBrush="#F1C77A" BorderThickness="1"
                                                Visibility="{Binding PendingWarning, Converter={StaticResource VisibleIf}}">
                                            <TextBlock Text="{Binding PendingWarning}" Foreground="{StaticResource Warn}" FontSize="13" TextWrapping="Wrap" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource BtnPrimary}" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource Btn}" Content="Предпросмотр протокола" Command="{Binding PreviewCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Нижняя полоса -->
                        <Border Grid.Row="4" Background="{StaticResource BgSoft}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12" Padding="18,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn}" Content="Предпросмотр" Command="{Binding PreviewCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Btn}" Content="Назад" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding NextText}" Command="{Binding NextCommand}" />
                                </StackPanel>
                                <TextBlock Text="Данные осмотра хранятся, пока не принято решение — можно переключаться между пациентами."
                                           Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Правая колонка ================= -->
            <StackPanel Grid.Column="2" Visibility="{Binding HasSelected, Converter={StaticResource VisibleIf}}">
                <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="+ назначить" Command="{Binding GoToOrdersCommand}" />
                            <TextBlock Text="Исследования" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Orders}" ItemTemplate="{StaticResource OrderRowCompact}" Focusable="False" />
                        <TextBlock Text="Не назначены" Style="{StaticResource Hint}" Visibility="{Binding NoOrders, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Поступление" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ArrivalNumber}" FontSize="12.5" Foreground="{StaticResource Ink2}" />
                        <TextBlock Text="{Binding ArrivalTime}" FontSize="12.5" Foreground="{StaticResource Ink2}" />
                        <TextBlock Text="{Binding ArrivalSource}" FontSize="12.5" Foreground="{StaticResource Ink2}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
