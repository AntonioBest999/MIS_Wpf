<Window x:Class="MisWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="РКБ · Приёмное отделение" Width="1500" Height="940" MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Bg}" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель: цвет зависит от роли -->
        <Border x:Name="Sidebar" Background="{StaticResource SidebarDoctor}" Padding="12,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#24FFFFFF">
                            <TextBlock Text="РКБ" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DeptTitle" Text="Приёмное" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="DeptSub" Text="отделение" Foreground="#B9CED8" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ModeText" Text="РЕЖИМ" Foreground="#9FBAC6" FontSize="11" Margin="12,0,0,6" />
                    <StackPanel x:Name="NavPanel" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" Padding="8,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF">
                                <TextBlock x:Name="Initials" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserName" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                <TextBlock Text="Смена 08:00 → 08:00" Foreground="#B9CED8" FontSize="11.5" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource NavButton}" Margin="-8,10,0,0" Click="Logout_Click">
                            <TextBlock Text="Выйти" />
                        </Button>
                    </StackPanel>
                </Border>
                <Grid />
            </DockPanel>
        </Border>

        <ContentControl x:Name="Host" Grid.Column="1" Focusable="False" />

        <!-- Уведомление -->
        <Border x:Name="Toast" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                MaxWidth="440" Background="{StaticResource Ink}" CornerRadius="10" Padding="16,12" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
